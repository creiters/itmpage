{
  "$schema": "https://modelcontextprotocol.io/schema/2024-11-05/schema.json",
  "name": "browser-native-llm",
  "version": "1.0.0",
  "description": "Browser-native offline Transformer LLM with SI-Radix Segment Interval Storage and WebRTC compute delegation",
  "protocolVersion": "2024-11-05",
  "capabilities": {
    "sampling": {
      "contextWindow": 1024,
      "maxTokens": 128,
      "streaming": true
    },
    "tools": {
      "listChanged": true
    },
    "resources": {
      "subscribe": false,
      "listChanged": true
    },
    "prompts": {
      "listChanged": false
    }
  },
  "model": {
    "architecture": "nano-transformer",
    "hiddenDim": 256,
    "numLayers": 6,
    "numHeads": 4,
    "vocabSize": 1024,
    "contextLength": 256,
    "storage": "IndexedDB-SI-Radix-4MB"
  },
  "tools": [
    {
      "name": "storage_query_chunks",
      "description": "Queries SI-Radix 4MB segment index records from IndexedDB",
      "inputSchema": {
        "type": "object",
        "properties": {
          "modelName": { "type": "string", "description": "Identifier of the model" }
        },
        "required": ["modelName"]
      }
    },
    {
      "name": "mesh_dispatch_compute",
      "description": "Dispatches computation across WebRTC mesh PIN channels",
      "inputSchema": {
        "type": "object",
        "properties": {
          "prompt": { "type": "string", "description": "Text prompt to evaluate" }
        },
        "required": ["prompt"]
      }
    },
    {
      "name": "train_model_step",
      "description": "Executes backpropagation on corpus text and updates parameters using AdamW",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": { "type": "string", "description": "Training corpus text segment" },
          "learningRate": { "type": "number", "default": 0.001 }
        },
        "required": ["text"]
      }
    },
    {
      "name": "get_training_metrics",
      "description": "Inspects parameter counts and optimization steps",
      "inputSchema": { "type": "object", "properties": {} }
    }
  ],
  "resources": [
    {
      "uri": "resource://model/si-radix-manifest",
      "name": "SI-Radix Interval Manifest",
      "mimeType": "application/json",
      "description": "O(1) segment interval boundaries and layer map"
    },
    {
      "uri": "resource://storage/status",
      "name": "Storage Status",
      "mimeType": "application/json",
      "description": "IndexedDB quota and persistence state"
    }
  ]
}
