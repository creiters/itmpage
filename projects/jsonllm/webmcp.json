{
  "$schema": "https://modelcontextprotocol.io/schema/2024-11-05/server.json",
  "name": "browser-jsonllm-server",
  "version": "2.0.0",
  "description": "Clean browser-native Model Context Protocol server powered by JSON models",
  "capabilities": {
    "tools": { "listChanged": true },
    "resources": { "subscribe": false, "listChanged": true },
    "sampling": {}
  },
  "tools": [
    {
      "name": "train_model_step",
      "description": "Train on-device weights with AdamW on arbitrary text",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": { "type": "string", "description": "Training corpus text" },
          "learningRate": { "type": "number", "default": 0.002 }
        },
        "required": ["text"]
      }
    },
    {
      "name": "save_model_to_json",
      "description": "Persist the trained model into IndexedDB as a clean JSON document",
      "inputSchema": {
        "type": "object",
        "properties": {
          "modelName": { "type": "string", "default": "agent-dialog" }
        }
      }
    },
    {
      "name": "rag_index_fact",
      "description": "Store a text guideline into the local vector RAG database",
      "inputSchema": {
        "type": "object",
        "properties": {
          "docId": { "type": "string" },
          "text": { "type": "string" }
        },
        "required": ["docId", "text"]
      }
    }
  ],
  "resources": [
    {
      "uri": "jsonllm://models/active",
      "name": "Active In-Memory JSON Model",
      "mimeType": "application/json"
    },
    {
      "uri": "jsonllm://rag/index",
      "name": "Vector RAG Index",
      "mimeType": "application/json"
    }
  ]
}
