{
  "$schema": "https://modelcontextprotocol.io/schema/2024-11-05/schema.json",
  "name": "vimtollm-server",
  "version": "3.0.0",
  "description": "vimtoLLM - all space inside! 10 on minus 84. browser-native Model Context Protocol server",
  "protocolVersion": "2024-11-05",
  "capabilities": {
    "tools": { "listChanged": true },
    "resources": { "subscribe": false, "listChanged": true },
    "sampling": {}
  },
  "model": {
    "name": "vimtoLLM - all space inside! 10 on minus 84.",
    "architecture": "nano-transformer",
    "precision": "fp16-fp4",
    "parameters": 3956736,
    "storage": "IndexedDB-Atomic-JSONLLM"
  },
  "tools": [
    {
      "name": "train_model_step",
      "description": "Executes on-device backpropagation using AdamW on target text",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": { "type": "string", "description": "Training corpus text" },
          "learningRate": { "type": "number", "default": 0.003 }
        },
        "required": ["text"]
      }
    },
    {
      "name": "generate_jsonllm",
      "description": "Packs active weights into an FP4/Q4 Deflate JSONLLM container in IndexedDB",
      "inputSchema": {
        "type": "object",
        "properties": {
          "modelName": { "type": "string", "default": "vimtollm-4m" },
          "mode": { "type": "string", "default": "fp4" }
        }
      }
    },
    {
      "name": "rag_index_document",
      "description": "Indexes a document into the local Vector RAG store",
      "inputSchema": {
        "type": "object",
        "properties": {
          "docId": { "type": "string" },
          "text": { "type": "string" }
        },
        "required": ["docId", "text"]
      }
    }
  ],
  "resources": [
    {
      "uri": "jsonllm://models/active",
      "name": "Active In-Memory vimtoLLM Model",
      "mimeType": "application/json"
    },
    {
      "uri": "jsonllm://rag/documents",
      "name": "Vector RAG Semantic Index",
      "mimeType": "application/json"
    }
  ]
}
