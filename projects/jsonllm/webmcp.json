{
  "$schema": "https://modelcontextprotocol.io/schema/2024-11-05/server.json",
  "name": "browser-jsonllm-server",
  "version": "1.0.0",
  "description": "Browser-native Model Context Protocol server powered by custom JSONLLM agents and vector RAG",
  "capabilities": {
    "tools": { "listChanged": true },
    "resources": { "subscribe": false, "listChanged": true },
    "sampling": {}
  },
  "tools": [
    {
      "name": "train_model_step",
      "description": "Execute backpropagation step on input text using AdamW on-device",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": { "type": "string", "description": "Training corpus text" },
          "learningRate": { "type": "number", "default": 0.002 }
        },
        "required": ["text"]
      }
    },
    {
      "name": "rag_index_document",
      "description": "Index arbitrary text into local client-side Vector RAG store",
      "inputSchema": {
        "type": "object",
        "properties": {
          "docId": { "type": "string" },
          "text": { "type": "string" }
        },
        "required": ["docId", "text"]
      }
    },
    {
      "name": "save_model_si_radix",
      "description": "Export current trained weights into 4MB SI-Radix JSONLLM slices in IndexedDB",
      "inputSchema": {
        "type": "object",
        "properties": {
          "modelName": { "type": "string", "default": "custom-agent-dialog" }
        }
      }
    }
  ],
  "resources": [
    {
      "uri": "jsonllm://models/active",
      "name": "Active In-Memory Small LLM",
      "mimeType": "application/json"
    },
    {
      "uri": "jsonllm://rag/documents",
      "name": "Vector RAG Semantic Index",
      "mimeType": "application/json"
    }
  ]
}
