{
  "$schema": "https://modelcontextprotocol.io/schema/2024-11-05/schema.json",
  "name": "browser-jsonllm-server",
  "version": "2.0.0",
  "description": "Browser-native Model Context Protocol server generating and serving JSONLLM models",
  "capabilities": {
    "tools": { "listChanged": true },
    "resources": { "subscribe": false, "listChanged": true },
    "sampling": {}
  },
  "tools": [
    {
      "name": "train_model_step",
      "description": "Executes on-device backpropagation using AdamW on target text",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": { "type": "string", "description": "Training corpus text" },
          "learningRate": { "type": "number", "default": 0.002 }
        },
        "required": ["text"]
      }
    },
    {
      "name": "generate_jsonllm",
      "description": "Compacts current transformer weights into a 4-bit Deflate JSONLLM envelope and stores it in IndexedDB",
      "inputSchema": {
        "type": "object",
        "properties": {
          "modelName": { "type": "string", "default": "browser-nano-llm" }
        }
      }
    },
    {
      "name": "rag_index_document",
      "description": "Indexes a text document into the local Vector RAG store",
      "inputSchema": {
        "type": "object",
        "properties": {
          "docId": { "type": "string" },
          "text": { "type": "string" }
        },
        "required": ["docId", "text"]
      }
    }
  ],
  "resources": [
    {
      "uri": "jsonllm://models/active",
      "name": "Active In-Memory JSONLLM",
      "mimeType": "application/json"
    },
    {
      "uri": "jsonllm://rag/documents",
      "name": "Vector RAG Semantic Index",
      "mimeType": "application/json"
    }
  ]
}
