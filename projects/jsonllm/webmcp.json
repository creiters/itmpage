{
  "$schema": "https://modelcontextprotocol.io/schema/2024-11-05/schema.json",
  "name": "vimtollm-server",
  "version": "3.1.0",
  "description": "vimtoLLM - all space inside! 10 on minus 84. Browser-Native WASM SIMD & WebMCP Server",
  "protocolVersion": "2024-11-05",
  "capabilities": {
    "tools": { "listChanged": true },
    "resources": { "subscribe": false, "listChanged": true },
    "sampling": {
      "contextWindow": 128,
      "maxTokens": 48
    }
  },
  "model": {
    "name": "vimtoLLM - all space inside! 10 on minus 84.",
    "architecture": "nano-transformer-4m",
    "precision": "fp16-fp4",
    "parameters": 3956736,
    "hardwareTarget": "WASM-SIMD-128",
    "storage": "IndexedDB-Atomic-JSONLLM"
  },
  "tools": [
    {
      "name": "train_model_step",
      "description": "Executes hardware-accelerated backpropagation using WASM SIMD & AdamW on JSON dialogue turns",
      "inputSchema": {
        "type": "object",
        "properties": {
          "targetAgent": { "type": "string", "default": "miriam" },
          "pairs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "u": { "type": "string" },
                "b": { "type": "string" }
              },
              "required": ["u", "b"]
            }
          },
          "epochs": { "type": "number", "default": 5 },
          "learningRate": { "type": "number", "default": 0.003 }
        },
        "required": ["pairs"]
      }
    },
    {
      "name": "generate_jsonllm",
      "description": "Quantizes active weights into an FP4 (E2M1) or Q4 Deflate JSONLLM checkpoint in IndexedDB",
      "inputSchema": {
        "type": "object",
        "properties": {
          "modelName": { "type": "string", "default": "miriam" },
          "mode": { "type": "string", "default": "fp4" }
        }
      }
    },
    {
      "name": "rag_index_document",
      "description": "Indexes a factual reference document into the agent-scoped Vector RAG database",
      "inputSchema": {
        "type": "object",
        "properties": {
          "docId": { "type": "string" },
          "agentId": { "type": "string", "default": "miriam" },
          "text": { "type": "string" }
        },
        "required": ["docId", "text"]
      }
    }
  ],
  "resources": [
    {
      "uri": "jsonllm://models/active",
      "name": "Active In-Memory Agent Weights",
      "mimeType": "application/json"
    },
    {
      "uri": "jsonllm://rag/index",
      "name": "Agent-Scoped Vector RAG Semantic Index",
      "mimeType": "application/json"
    }
  ]
}
